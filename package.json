{
  "name": "proctor-browser",
  "version": "2.3.17",
  "description": "AI Proctored Exam Browser",
  "author": "Procta",
  "main": "main.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --dir",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "bundle-python": "node bundle-python.js",
    "lint": "eslint main.js preload.js lobby_preload.js setup-preload.js lib/",
    "lint:fix": "eslint --fix main.js preload.js lobby_preload.js setup-preload.js lib/",
    "lint:py": "pip-audit -r requirements.txt 2>/dev/null; echo '---'; python3 -c \"import ast,os,sys;bad=[]; [bad.append(f'{p}:{e.lineno}:{e.msg}') for root,_,files in os.walk('app') if '__pycache__' not in root for f in files if f.endswith('.py') for p in [os.path.join(root,f)] for c in [open(p).read()] for e in [ast.parse(c)] if type(e)==SyntaxError]; [print(b) for b in bad]; sys.exit(1) if bad else print('Python clean')\"",
    "type-check": "npm run lint",
    "test": "node scripts/electron-smoke-test.mjs",
    "verify:mac": "node scripts/verify-macos-build.mjs"
  },
  "dependencies": {
    "@sentry/electron": "^7.0.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "eslint": "^8.57.1",
    "https-proxy-agent": "^9.0.0"
  },
  "build": {
    "appId": "net.procta.browser",
    "productName": "Procta",
    "asar": true,
    "afterPack": "build/afterPack.js",
    "files": [
      "main.js",
      "config.js",
      "preload.js",
      "lobby_preload.js",
      "setup-preload.js",
      "lib/**/*",
      "renderer/**/*",
      "build/icon.png",
      "build/icon.ico",
      "app/static/student.html",
      "app/static/theme.css",
      "app/static/tokens.css",
      "app/static/components.css",
      "app/static/_safe.js",
      "app/static/student-app.js",
      "app/static/favicon.svg",
      "app/static/favicon-16.png",
      "app/static/favicon-32.png",
      "app/static/favicon-48.png",
      "app/static/apple-touch-icon.png",
      "app/static/icon-192.png",
      "app/static/icon-512.png",
      "app/static/icon-192-maskable.png",
      "app/static/icon-512-maskable.png",
      "app/static/site.webmanifest"
    ],
    "extraResources": [
      {
        "from": "proctor.py",
        "to": "proctor.py"
      },
      {
        "from": "behavioral_analysis.py",
        "to": "behavioral_analysis.py"
      },
      {
        "from": "audio_processor.py",
        "to": "audio_processor.py"
      },
      {
        "from": "weights",
        "to": "weights"
      },
      {
        "from": "scripts/download_audio_models.py",
        "to": "scripts/download_audio_models.py"
      },
      {
        "from": "python-runtime",
        "to": "python-runtime"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "ArihantK15",
      "repo": "proctor-browser"
    },
    "protocols": [
      {
        "name": "Procta Invite",
        "schemes": [
          "procta"
        ]
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "grantFileProtocolExtraPrivileges": false,
      "onlyLoadAppFromAsar": true,
      "resetAdHocDarwinSignature": true
    },
    "mac": {
      "icon": "build/icon.icns",
      "extendInfo": {
        "NSCameraUsageDescription": "Procta uses your camera to proctor your exam and verify your identity.",
        "NSMicrophoneUsageDescription": "Procta uses your microphone to detect background audio during your exam."
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "createDesktopShortcut": true,
      "runAfterFinish": true,
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false
    }
  }
}
