# ── Global options ──────────────────────────────────────────────
# When Procta sits behind Cloudflare, every TCP connection lands
# from a Cloudflare edge IP. Without this block, every request would
# look like it came from one of ~15 IPs, breaking IP-based rate
# limits, lockouts, and audit logs.
#
# `trusted_proxies` tells Caddy to trust the `CF-Connecting-IP`
# header (which Cloudflare always sets to the real client IP) ONLY
# when the request actually came from a Cloudflare range. Anyone
# spoofing the header from outside is ignored.
#
# IP ranges are kept fresh by the `cloudflare-ips` module if you
# build a custom Caddy image — otherwise the static list below is
# updated by Cloudflare ~once a year (https://www.cloudflare.com/ips/).
{
    servers {
        trusted_proxies static \
            173.245.48.0/20 \
            103.21.244.0/22 \
            103.22.200.0/22 \
            103.31.4.0/22 \
            141.101.64.0/18 \
            108.162.192.0/18 \
            190.93.240.0/20 \
            188.114.96.0/20 \
            197.234.240.0/22 \
            198.41.128.0/17 \
            162.158.0.0/15 \
            104.16.0.0/13 \
            104.24.0.0/14 \
            172.64.0.0/13 \
            131.0.72.0/22 \
            2400:cb00::/32 \
            2606:4700::/32 \
            2803:f800::/32 \
            2405:b500::/32 \
            2405:8100::/32 \
            2a06:98c0::/29 \
            2c0f:f248::/32
        client_ip_headers CF-Connecting-IP X-Forwarded-For
    }
}

app.procta.net {
    encode gzip

    # ── Rate limiting ─────────────────────────────────────────────────
    # Caddy-level rate limiting REMOVED 2026-05-14 because the
    # `rate_limit` directive comes from the third-party caddy-ratelimit
    # plugin (mholt/caddy-ratelimit) which the stock caddy:2-alpine
    # image doesn't include. The Caddyfile referenced it without a
    # matching custom image, which crash-looped Caddy.
    #
    # The application layer already enforces per-endpoint rate limits
    # via slowapi — 51 `@limiter.limit(...)` decorators in auth.py
    # alone (signup: 5/hour, login: 10/minute, password-reset:
    # 3/minute, OTP request: 3/10min, etc). That's defence at the
    # right layer.
    #
    # To re-enable Caddy-level rate limiting (useful for edge IP-ban
    # before requests hit the app), switch docker-compose.yml to:
    #     image: ghcr.io/mholt/caddy-ratelimit:latest
    # or build a custom Caddy image with `caddy build` + the plugin.
    # Until then, do NOT add `rate_limit` directives here.

    # ── Global security headers ──────────────────────────────────────
    header {
        # HSTS: force HTTPS for 1 year
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        # Prevent clickjacking
        X-Frame-Options "DENY"
        # Block MIME sniffing
        X-Content-Type-Options "nosniff"
        # Referrer policy: only send origin on cross-origin requests
        Referrer-Policy "strict-origin-when-cross-origin"
        # Prevent other sites from embedding our resources
        X-Permitted-Cross-Domain-Policies "none"
        # Isolate this origin from others (mitigates Spectre-style attacks)
        Cross-Origin-Opener-Policy "same-origin"
    }

    # ── Static CSS / JS / SVG / favicon ────────────────────────────────
    # Serve pre-compressed .gz variants when available (dashboard.html
    # is ~150KB uncompressed, ~35KB gzipped). Caddy falls back to
    # on-the-fly gzip for other assets.
    @assets path *.css *.js *.svg *.ico *.html
    handle @assets {
        root * /srv
        file_server
        header Cache-Control "no-cache, must-revalidate"
    }
    # ── Other static (images, fonts, downloads) — fine to cache hard ──
    handle /static/* {
        root * /srv
        file_server
        header Cache-Control "public, max-age=86400"
    }

    # ── HTML pages: no-cache so auth checks always run fresh ──
    handle /dashboard {
        root * /srv/static
        rewrite * /dashboard.html
        file_server
        header Cache-Control "no-cache, no-store, must-revalidate"
    }
    handle /download {
        root * /srv/static
        rewrite * /download.html
        file_server
        header Cache-Control "no-cache, no-store, must-revalidate"
    }
    handle /register {
        root * /srv/static
        rewrite * /register.html
        file_server
        header Cache-Control "no-cache, no-store, must-revalidate"
    }
    handle /student {
        root * /srv/static
        rewrite * /student.html
        file_server
        header Cache-Control "no-cache, no-store, must-revalidate"
    }
    handle /privacy {
        root * /srv/static
        rewrite * /privacy.html
        file_server
        header Cache-Control "no-cache, no-store, must-revalidate"
    }
    handle /privacy-policy {
        root * /srv/static
        rewrite * /privacy-policy.html
        file_server
        header Cache-Control "no-cache, no-store, must-revalidate"
    }
    handle /dpa {
        root * /srv/static
        rewrite * /dpa.html
        file_server
        header Cache-Control "no-cache, no-store, must-revalidate"
    }
    handle /trust-center {
        root * /srv/static
        rewrite * /trust-center.html
        file_server
        header Cache-Control "no-cache, no-store, must-revalidate"
    }
    handle /security-questionnaire {
        root * /srv/static
        rewrite * /security-questionnaire.html
        file_server
        header Cache-Control "no-cache, no-store, must-revalidate"
    }
    handle /api-docs {
        root * /srv/static
        rewrite * /api-docs.html
        file_server
        header Cache-Control "no-cache, no-store, must-revalidate"
    }
    handle /student-react* {
        root * /srv/static/student-react
        file_server
        header Cache-Control "no-cache, no-store, must-revalidate"
    }

    # ── Everything else: API ──
    handle {
        reverse_proxy api:8000 {
            flush_interval -1
        }
    }
}
