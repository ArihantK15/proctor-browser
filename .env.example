SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_MANAGEMENT_TOKEN=your-mgmt-token   # for running migrations via scripts/run_migrations.py
# SUPABASE_SKIP_STARTUP_CHECK=false         # set true to skip Supabase ping on startup

# ── Database/Auth backend switch ────────────────────────────────
# Default is the legacy Supabase path. For the KVM Postgres cutover:
#   DATABASE_BACKEND=postgres
#   AUTH_PROVIDER=local
#   DATABASE_URL=postgresql://procta:<url-encoded-password>@proctor-postgres:5432/procta
# Note: values in .env are not shell-expanded by env_file, so do not write
# DATABASE_URL=...:${POSTGRES_PASSWORD}@... here. Put the encoded password in
# DATABASE_URL directly when cutting over production.
# During transition, AUTH_PROVIDER=hybrid lets no-hash legacy users keep
# using Supabase Auth while password resets/new signups create local hashes.
DATABASE_BACKEND=supabase
AUTH_PROVIDER=supabase
# DATABASE_URL=postgresql://procta:change-me@proctor-postgres:5432/procta
# POSTGRES_DB=procta
# POSTGRES_USER=procta
# POSTGRES_PASSWORD=change-me
# POSTGRES_POOL_MIN=3
# POSTGRES_POOL_MAX=20
# POSTGRES_COMMAND_TIMEOUT=15

# KVM resource limits. These are Docker container caps, not host RAM.
# The KVM can have 16 GB RAM + swap; each container still shows its own cap.
# API_MEMORY_LIMIT=4g
# API_CPU_LIMIT=3.0
# API_MEMSWAP_LIMIT=6g
# POSTGRES_MEMORY_LIMIT=6g
# POSTGRES_CPU_LIMIT=3.0
# POSTGRES_MEMSWAP_LIMIT=8g

ADMIN_PASSWORD=your-admin-password
EXIT_CODE=EXIT2026
EXAM_ACCESS_CODE=
SUPER_ADMIN_EMAIL=admin@example.com         # receives org-invite bounce notifications
APP_URL=https://procta.net                  # used for CORS, invite links, etc.
INVITE_BASE_URL=https://procta.net          # base URL for org-invite links

# ── Storage ──────────────────────────────────────────────────────
SCREENSHOTS_DIR=/app/screenshots
SCREENSHOT_RETENTION_DAYS=90               # auto-cleanup old screenshots
QUESTION_IMG_DIR=/app/question_images
LOG_DIR=/app/logs

# ── Email ────────────────────────────────────────────────────────
# EMAIL_PROVIDER=resend                    # default: resend (smtp not yet supported)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx         # https://resend.com/api-keys
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxx       # for inbound email webhook verification
EMAIL_FROM=noreply@procta.net
EMAIL_FROM_NAME=Procta
EMAIL_REPLY_TO=support@procta.net

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Defaults to Electron file://
# origin, localhost (dev), and https://app.procta.net.
# Set this explicitly in production to restrict access.
# CORS_ALLOWED_ORIGINS=https://app.procta.net

# ── Redis (for SSE pub/sub, rate limiting, invite dedup, RQ queues) ──
REDIS_URL=redis://redis:6379
# RQ_ENABLED=true                          # set false to run jobs synchronously (dev/test)
# RQ_QUEUE=default,scoring                 # comma-separated queues this worker consumes (default: default,scoring)
# RQ_RETRY_MAX=3                           # max retries for failed jobs (default: 3)
# RQ_RETRY_INTERVALS=10,60,300             # seconds between retries (default: 10,60,300)

# ── Installer downloads ──────────────────────────────────────────
# (see RELEASE_REPO below). Normally you don't need to set DOWNLOAD_*
# — leave them blank and the backend resolves them on the fly, cached
# for 10 minutes.
#
# Only set these if you want to PIN a specific version (e.g. during a
# staged rollout, or if the latest release is broken). Env values
# OVERRIDE auto-discovery.
DOWNLOAD_MAC_ARM=
DOWNLOAD_MAC_X64=
DOWNLOAD_WIN=

# Auto-discovery config (these have sensible defaults, shown here for
# reference — uncomment only to override)
# RELEASE_REPO=ArihantK15/proctor-browser
# RELEASE_TTL_SEC=600
# GITHUB_TOKEN=   # optional — raises API limit from 60/hr to 5000/hr

# ── LLM (provider-agnostic) ──────────────────────────────────────
# Powers AI question generation, auto-tags, and scorecard insights.
# If unset, those features return 503 with a clear error — everything
# else still works (proctoring, exam delivery, scoring, dashboards).
#
# Works with any OpenAI-compatible chat-completions API. Pick whichever
# free provider you prefer:
#
#   GROQ (recommended — fastest, generous free tier, no credit card)
#     LLM_API_KEY=gsk_xxxxxxxxxxxxxxxx
#     LLM_BASE_URL=https://api.groq.com/openai/v1
#     LLM_MODEL=llama-3.3-70b-versatile
#     Sign up: https://console.groq.com/keys
#     Limit:   14,400 req/day @ ~600 tok/s
#
#   OPENROUTER (huge model selection, some truly :free models)
#     LLM_API_KEY=sk-or-v1-xxxxxxxx
#     LLM_BASE_URL=https://openrouter.ai/api/v1
#     LLM_MODEL=google/gemini-2.0-flash-exp:free
#     Sign up: https://openrouter.ai/keys
#     Limit:   varies per model; :free models are rate-limited
#
#   CEREBRAS (fastest Llama, ~10K req/day free)
#     LLM_API_KEY=csk-xxxxxxxx
#     LLM_BASE_URL=https://api.cerebras.ai/v1
#     LLM_MODEL=llama3.3-70b
#     Sign up: https://cloud.cerebras.ai
#
#   LOCAL OLLAMA (no API call, but slow on CPU and needs a host with
#   16+ GB RAM for 70B models; consider llama3.1:8b for the droplet)
#     LLM_API_KEY=ollama-no-key-needed
#     LLM_BASE_URL=http://localhost:11434/v1
#     LLM_MODEL=llama3.1:8b
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
# LLM_TIMEOUT=30                        # seconds, optional

# ── Billing & Checkout (Razorpay) ───────────────────────────────
# Get keys at https://dashboard.razorpay.com/app/keys
# Used by BOTH the subscription router (app/routers/billing.py) and
# the one-shot Standard Checkout router (app/routers/checkout.py).
# If unset, both flows run in sandbox mode (mock responses).
#
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx           # rzp_test_* in dev, rzp_live_* in prod
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxx           # NEVER expose to frontend
# RAZORPAY_WEBHOOK_SECRET=whsec_xxxxx         # for /webhooks/razorpay signature
# Subscription plan IDs (created in Razorpay dashboard):
# RAZORPAY_PLAN_STARTER=plan_xxxxx
# RAZORPAY_PLAN_GROWTH=plan_xxxxx
# RAZORPAY_PLAN_SCALE=plan_xxxxx
#
# Frontend reads ONLY the public key id via Vite env in website/.env.local:
#   VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# The secret must never reach client bundles.

# ── Monitoring (optional) ────────────────────────────────────────
# Sentry error tracking — set to enable automatic 500 reporting.
# Get your DSN at https://sentry.io/organizations/<org>/projects/
# SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/zzz
# SENTRY_ENVIRONMENT=production          # default: production
# SENTRY_TRACES_SAMPLE_RATE=0.1          # default: 0.1 (10%)
# SENTRY_PROFILES_SAMPLE_RATE=0.0        # default: 0 (disabled)

# ── Proctor (Electron renderer) ──────────────────────────────────
# These are read by the Electron renderer process (proctor.py / config.js).
# PROCTOR_DEBUG=0                        # set 1 for verbose logging
# PROCTOR_HEADLESS=0                     # set 1 to run without display
# PROCTOR_SKIP_ENROLLMENT=0              # set 1 to skip face enrollment
# PROCTOR_CALIBRATION_MODE=0             # set 1 for calibration UI
# PROCTOR_SERVER_URL=http://localhost:8000
# PROCTOR_EVIDENCE_DIR=/tmp/proctor_evidence
# PROCTOR_EAR_MODEL=/app/models/ear.onnx
# PROCTOR_GAZE_MODEL=/app/models/gaze.onnx

# ── Load-testing (optional) ─────────────────────────────────────
# LOADTEST_SECRET=your-secret            # authenticates /api/v1/loadtest/* endpoints

# ── Misc ──────────────────────────────────────────────────────────
# LIVEFRAME_MAX_SESSIONS=1000            # max concurrent live-frame sessions
# REMINDER_LOOP_DISABLED=false           # set true to disable reminder cron loop

# Legacy GROQ_* names still work as fallbacks if you've already set them.
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Google Classroom API
# GOOGLE_CLASSROOM_CLIENT_ID=xxxxx.apps.googleusercontent.com
# GOOGLE_CLASSROOM_CLIENT_SECRET=GOCSPX-xxxxx
# GOOGLE_CLASSROOM_REDIRECT_URI=https://app.procta.net/api/v1/google/callback

# TOTP 2FA encryption key (change this before deploying to production)
# TOTP_ENCRYPTION_KEY=

# ── OAuth Sign-In ───────────────────────────────────────────────
# Supabase auth mode:
# Providers are configured in the SUPABASE AUTH DASHBOARD. The callback
# URL whitelist needs:
#     {APP_URL}/api/v1/auth/oauth/callback
#
# To enable Google sign-in:
#   1. Google Cloud Console → new "Procta Sign-In" OAuth client
#      (separate from the Classroom client so the consent screen says
#      "Procta wants your email + profile" not "...Classroom access")
#   2. Redirect URI: https://<project>.supabase.co/auth/v1/callback
#   3. Supabase → Authentication → Providers → Google → ON, paste keys
#   4. Supabase → Authentication → URL Configuration → Redirect URLs:
#      add https://app.procta.net/api/v1/auth/oauth/callback
#
# To enable Microsoft sign-in:
#   1. Entra ID → App registrations → multi-tenant (Personal + Work)
#   2. Same Supabase redirect URI as Google
#   3. Supabase → Providers → Azure → ON
#
# Local/Postgres auth mode:
# Set AUTH_PROVIDER=local, then configure direct server-side OAuth clients.
# Use this redirect URI in Google Cloud / Microsoft Entra:
#     {APP_URL}/api/v1/auth/oauth/callback
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=
#
# ── Cloudflare Turnstile (CAPTCHA) ──────────────────────────────
# Free, invisible by default (Managed mode). Wired on signup, login,
# password-reset, resend-verification. Falls back to allow-all when
# unset (dev mode).
# TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxx       # public, frontend reads via VITE_
# TURNSTILE_SECRET_KEY=0x4AAAAAAAxxxxxx     # server-only
#
# Frontend equivalents in website/.env.local:
#   VITE_TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxx

# ── Caddy resource limits ─────────────────────────────────────────
# Raise these if Caddy memory % climbs over ~70 % under load. TLS
# session cache + keep-alive buffers scale with concurrent connection
# count. The defaults below (1 GB) comfortably handle 5 000+ VUs;
# the compose file falls back to 512 MB / 1.0 CPU if these are unset.
CADDY_MEMORY_LIMIT=1g
CADDY_MEMSWAP_LIMIT=1536m
CADDY_CPU_LIMIT=2.0

# ── Async exam scoring (Fix #2 — burst submit handling) ──────────
# When `1`, /submit-exam returns 202 immediately after persisting
# answers + marking status='submitted', and an RQ worker computes
# score + risk + LMS passback in the background. The renderer polls
# /api/v1/session-status until the score lands.
#
# Leave unset (default off) to use the legacy inline-scoring path.
# Recommended ON in production once you've verified the RQ scoring
# queue is consuming jobs in 'docker logs proctor-worker'.
ASYNC_SCORING_ENABLED=1

# ── Uvicorn workers (Fix #1) ────────────────────────────────────
# One worker per CPU core, capped at 4 on the KVM 4 (4 vCPU) box.
# Hostinger KVM 4 = 4 vCPU; using all of them lets the submit wave
# spread across cores instead of queuing on 2 workers.
UVICORN_WORKERS=4
