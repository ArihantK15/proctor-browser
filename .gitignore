node_modules/
dist/
build/dist/
venv/
.venv/
*.pt
.DS_Store
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
coverage.xml
.coverage
.coverage.*

# Local scan / scratch outputs — never commit
bandit.json
supabase/.temp/

# k6 load test summaries dumped at repo root
/summary-*.json
loadtest/loadtest_tokens*.json

# Environment & secrets — never commit
.env
.env.*
!.env.example
# Vite reads .env.production at build time to inline build-public
# values into the JS bundle. Sentry DSNs (project identifiers, NOT
# auth secrets) live here — Sentry's docs explicitly say DSNs can be
# committed. Keep .env / .env.local gitignored for actual secrets.
!app/dashboard-ui/.env.production
!app/student-ui/.env.production
app/credentials.json

# Runtime data — generated on server
logs/
screenshots/
data/proctoring.db
*.db

# Installer binaries — too large for git (use GitHub Releases)
app/downloads/
*.dmg
*.exe

# Python runtime baked at build time by bundle-python.js (Windows) — never
# commit the (large) interpreter/wheels; keep only the .gitkeep so the dir
# exists for electron-builder's extraResources (mirrors python-runtime/).
/resources/python/*
!/resources/python/.gitkeep

# Exam config — managed per-deployment
questions.json

# Load test reports — generated locally
loadtest/reports/

# PDF reports — generated locally
Procta_Development_Report.pdf
generate_report.py

# Build outputs — generated during Docker build
app/static/dashboard-react/
app/static/student-react/

# Stale generated files (should not be tracked)
app/routers/checkout.py
website/src/components/RazorpayCheckoutButton.jsx

# Claude Code / agent harness scratch (created at session boundary,
# not project-relevant; per-machine state).
skills-lock.json
.agents/
.claude/

# VC++ runtime fetched by CI for the Windows installer (not committed)
build/vc_redist.x64.exe
